# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.netlify.app
MOBILE_URL=http://localhost:8081

# Database Configuration
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/koshk_ecommerce?retryWrites=true&w=majority

# Redis & Session Configuration
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SECRET=your_redis_password
SESSION_SECRET=your_super_secret_session_key_here

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Email / SMTP (Mailtrap / SendGrid / Resend)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@koshkstore.com

# Paymob Payment Gateway
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_IFRAME_ID=your_card_iframe_id

# Paymob Integration IDs
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id
PAYMOB_WALLET_INTEGRATION_ID=your_wallet_integration_id
PAYMOB_KIOSK_INTEGRATION_ID=your_kiosk_integration_id
PAYMOB_VALU_INTEGRATION_ID=your_valu_integration_id
PAYMOB_VALU_IFRAME_ID=your_valu_iframe_id